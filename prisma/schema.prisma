generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  GUEST
  LIAISON
  SALES_REP
  SALES_MGR
  DEALER_PRO
  BROKER
  AMP_AFFILIATE
  EXECUTIVE_ADMIN
  MEMBER
  LOAN_OFFICER
}

enum SubscriptionTier {
  MARKETPLACE
  CRM
  CENTRAL_OFFICE
}

enum VehicleStatus {
  AVAILABLE
  HOLD
  PENDING_SALE
  SOLD
  DRAFT
  IN_RECON
}

enum LeadStatus {
  New
  Assigned
  In_Progress
  Test_Drive_Scheduled
  Contract_Pending
  Closed_Won
  Closed_Lost
  Expired
}

enum DealStatus {
  PENDING
  DESKING
  E_SIGN
  FINANCED
  CLOSED
}

enum ESignStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  FUNDED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadQualification {
  BUY_NOW
  BUYER_SHOPPING_AROUND
  TAKING_TIME
  SHOPPING_AROUND
  NEW_LEAD
}

enum AssignmentAction {
  ASSIGNED
  RELEASED
}

enum LoanStatus {
  PENDING
  UNDERWRITING
  APPROVED
  FUNDED
  REJECTED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model Store {
  reconditioningOrders ReconditioningOrder[]
  id              String  @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  name            String
  dba             String?
  street_address  String?
  city            String
  state           String
  zip             String?
  phone           String?
  dms_provider    String  @default("CDK") // CDK, DealerSocket, Frazer
  dms_account_id  String?
  is_pilot_dealer Boolean @default(false)
  activeUnits     Int     @default(0)

  // Verified Auto Dealer Features
  isVerifiedDealer   Boolean @default(false)
  chatEnabled        Boolean @default(false)
  clickToCallEnabled Boolean @default(false)
  bhphEnabled        Boolean @default(false)
  advertisingTier    String? @default("STANDARD") // STANDARD, ADVANCED, PREMIUM

  licenseStatus    String?
  licenseExpiresAt DateTime?

  users          User[]
  vehicles       Vehicle[]
  deals          Deal[]
  expenses       Expense[]
  roiReports     ROIReport[]
  leads          Lead[]
  trackingEvents TrackingEvent[]
  documents      DealerDocument[]
  contracts      DealershipContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store")
}

model Organization {
  integrationSettings IntegrationSetting[]
  teamInvitations TeamInvitation[]
  phoneSetting PhoneSetting?
  websiteSettings WebsiteSetting?
  reconditioningOrders ReconditioningOrder[]
  id        String   @id @default(uuid())
  name      String
  
  stores    Store[]
  users     User[]
  verification OrganizationVerification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization")
}

model User {
  id      String  @id @default(uuid())
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  role         Role    @default(GUEST)
  roleName     String?
  full_name    String?
  email        String? @unique
  passwordHash String?
  phone        String?
  is_active    Boolean @default(true)
  badge        String?
  theme        String  @default("light")
  defaultRoute String?

  subscriptions UserSubscription[]

  // Relations
  vehiclesPosted   Vehicle[]       @relation("PostedVehicles")
  favorites        Favorite[]
  dealsHandled     Deal[]          @relation("SalesRepsOnDeal")
  dealsClosed      Deal[]          @relation("ClosingManager")
  messagesSent     Message[]       @relation("Sender")
  messagesReceived Message[]       @relation("Receiver")
  leadsAssigned    Lead[]          @relation("AssignedLeads")
  leadsReferred    Lead[]          @relation("AmpAffiliate")
  callLogs         CallLog[]
  salesNotes       SalesNote[]
  affiliateLinks   AffiliateLink[]
  commissions      Commission[]

  endUserLeads        Lead[]              @relation("EndUserLeads")
  trackingEvents      TrackingEvent[]
  notifications       LeadNotification[]
  assignmentsMade     LeadAssignmentLog[] @relation("AssignedByUser")
  assignmentsReceived LeadAssignmentLog[] @relation("AssignedToUser")
  transportBookings   TransportBooking[]
  leadMessages        LeadMessage[]
  loanApplications    LoanApplication[]
  documentsUploaded   DealerDocument[] @relation("UploadedDocuments")
  documentsReviewed   DealerDocument[] @relation("ReviewedDocuments")
  contractsSigned     DealershipContract[] @relation("SignedContracts")
  contractsReviewed   DealershipContract[] @relation("ReviewedContracts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model UserSubscription {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier
  active    Boolean          @default(true)
  startDate DateTime         @default(now())
  endDate   DateTime?

  @@map("usersubscription")
}

model Vehicle {
  vehicleMedia VehicleMedia[]
  publishing VehiclePublishing?
  reconditioningOrders ReconditioningOrder[]
  id      String  @id @default(uuid())
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  vin            String?       @unique
  year           Int?
  make           String?
  model          String?
  trim           String?
  body_class     String?
  selling_price  Float         @default(0.0)
  mileage        Int           @default(0)
  exterior_color String?
  transmission   String        @default("Automatic")
  lot_status     VehicleStatus @default(AVAILABLE)
  image_urls     Json?
  last_dms_sync  DateTime?

  title       String?
  category    String?
  location    String?
  truYou      Boolean @default(false)
  marketPrice Float?
  titleStatus String?
  carfaxUrl   String?
  isPromoted  Boolean @default(false)

  posterId String?
  poster   User?   @relation("PostedVehicles", fields: [posterId], references: [id])

  favoritedBy    Favorite[]
  leads          Lead[]
  deals          Deal[]
  reconTickets   ReconTicket[]
  photos         VehiclePhoto[]
  socialPosts    SocialPost[]
  trackingEvents TrackingEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("vehicle")
}

model RolePermission {
  id          String   @id @default(uuid())
  role        Role     @unique
  permissions Json?
  updatedAt   DateTime @updatedAt

  @@map("rolepermission")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@map("favorite")
}

model Lead {
  id        String   @id @default(uuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  amp_affiliate_id String?
  amp_affiliate    User?   @relation("AmpAffiliate", fields: [amp_affiliate_id], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String?

  buying_timeline        String?
  is_buy_now             Boolean @default(false)
  phone_consent          Boolean @default(false)
  dwell_duration_seconds Int     @default(10)

  status        LeadStatus         @default(New)
  qualification LeadQualification?
  score         Int                @default(0)
  notes         String?
  source        String?

  expires_at DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  endUserId String?
  endUser   User?   @relation("EndUserLeads", fields: [endUserId], references: [id], onDelete: SetNull)

  callLogs       CallLog[]
  salesNotes     SalesNote[]
  deals          Deal[]
  notifications  LeadNotification[]
  assignmentLogs LeadAssignmentLog[]
  messages       LeadMessage[]

  @@map("lead")
}

model LeadMessage {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  isFromLead Boolean  @default(false)
  read       Boolean  @default(false)
  source     String   @default("OMP_INBOX")
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@map("leadmessage")
}

model CallLog {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  repId  String
  rep    User   @relation(fields: [repId], references: [id], onDelete: Restrict)

  disposition          String
  duration_seconds     Int       @default(0)
  scheduled_test_drive DateTime?

  createdAt DateTime @default(now())

  @@map("calllog")
}

model SalesNote {
  id       String @id @default(uuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  content   String
  createdAt DateTime @default(now())

  @@map("salesnote")
}

model Deal {
  paymentInstallments PaymentInstallment[]
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  salesRepId String
  salesRep   User   @relation("SalesRepsOnDeal", fields: [salesRepId], references: [id])

  closingManagerId String?
  closingManager   User?   @relation("ClosingManager", fields: [closingManagerId], references: [id])

  customerName String
  status       DealStatus @default(PENDING)

  // 60s Desking Calculator / 4-Square Data
  sale_price      Float
  down_payment    Float @default(0.0)
  trade_allowance Float @default(0.0)
  trade_payoff    Float @default(0.0)
  doc_fee         Float @default(899.00)
  tax_amount      Float @default(0.0)
  apr             Float @default(0.0)
  term_months     Int   @default(72)
  monthly_payment Float @default(0.0)
  dealer_reserve  Float @default(0.0)

  esign_status ESignStatus @default(DRAFT)
  signed_at    DateTime?

  // Finance & BHPH
  lenderId      String?
  lender        Lender?      @relation(fields: [lenderId], references: [id])
  isBHPH        Boolean      @default(false)
  bhphAccountId String?      @unique
  bhphAccount   BHPHAccount? @relation(fields: [bhphAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deal")
}

model Message {
  id         String @id @default(uuid())
  senderId   String
  sender     User   @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("Receiver", fields: [receiverId], references: [id])

  content String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("message")
}

// -----------------------------------------------------------------------------
// DEALERSHIP OPERATIONS & EXECUTIVE SUITE
// -----------------------------------------------------------------------------

model DMSFeed {
  id               String   @id @default(uuid())
  provider         String // CDK, Reynolds, DealerTrack, etc.
  lastSync         DateTime @default(now())
  status           String // SUCCESS, FAILED
  recordsProcessed Int      @default(0)

  @@map("dmsfeed")
}

model ReconTicket {
  id          String       @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  description String
  cost        Float
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("reconticket")
}

model VehiclePhoto {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  url          String
  isAIEnhanced Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("vehiclephoto")
}

model SocialPost {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  platform  String // Facebook, Instagram, Twitter
  content   String
  postedAt  DateTime @default(now())

  @@map("socialpost")
}

model Expense {
  id       String   @id @default(uuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id])
  category String
  amount   Float
  description String?
  receiptUrl String?
  date     DateTime @default(now())

  @@map("expense")
}

model ROIReport {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  month      Int
  year       Int
  revenue    Float
  costs      Float
  roiPercent Float
  createdAt  DateTime @default(now())

  @@map("roireport")
}

// -----------------------------------------------------------------------------
// FINANCING & BHPH SUITE
// -----------------------------------------------------------------------------

model Lender {
  id    String @id @default(uuid())
  name  String
  tier  String // Prime, Subprime, etc.
  deals Deal[]

  @@map("lender")
}

model BHPHAccount {
  id              String        @id @default(uuid())
  balance         Float
  nextPaymentDate DateTime
  status          String // CURRENT, PAST_DUE, DEFAULT
  deal            Deal?
  payments        BHPHPayment[]

  @@map("bhphaccount")
}

model BHPHPayment {
  id        String      @id @default(uuid())
  accountId String
  account   BHPHAccount @relation(fields: [accountId], references: [id])
  amount    Float
  date      DateTime    @default(now())

  @@map("bhphpayment")
}

// -----------------------------------------------------------------------------
// AMP AFFILIATE MARKETING & SAFETY
// -----------------------------------------------------------------------------

model AffiliateLink {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  ref_code              String   @unique
  commission_rate       Float    @default(250.00)
  total_clicks          Int      @default(0)
  total_sales           Int      @default(0)
  total_commission_paid Float    @default(0.00)
  createdAt             DateTime @default(now())

  @@map("affiliatelink")
}

model Commission {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  status    String // PENDING, PAID
  createdAt DateTime @default(now())

  @@map("commission")
}

model PoliceSafeSpot {
  id               String   @id @default(uuid())
  department_name  String
  street_address   String
  city             String
  state            String
  zip              String
  latitude         Float
  longitude        Float
  surveillance_247 Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("policesafespot")
}

model TrackingEvent {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  duration_seconds Int
  createdAt        DateTime @default(now())

  @@index([storeId, createdAt])
  @@map("trackingevent")
}

model LeadAssignmentLog {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignedById String
  assignedBy   User   @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)

  action    AssignmentAction
  createdAt DateTime         @default(now())

  @@index([leadId])
  @@map("leadassignmentlog")
}

model LeadNotification {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  read      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([expiresAt])
  @@map("leadnotification")
}

model TransportBooking {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originZip      String
  destZip        String
  carrierType    String
  estimatedMiles Int
  estimatedPrice Float
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@map("transportbooking")
}

// -----------------------------------------------------------------------------
// OAL NETWORK (LOANS)
// -----------------------------------------------------------------------------

model LoanCategory {
  id           String            @id @default(uuid())
  name         String
  creditType   String
  approvalTime String
  description  String
  iconName     String
  isActive     Boolean           @default(true)
  applications LoanApplication[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("loancategory")
}

model LoanApplication {
  id              String        @id @default(uuid())
  categoryId      String?
  category        LoanCategory? @relation(fields: [categoryId], references: [id])
  loanType        String?
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  applicantName   String
  email           String
  phone           String
  businessName    String?
  requestedAmount Float
  status          LoanStatus   @default(PENDING)
  kycConsent      Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("loanapplication")
}

// -----------------------------------------------------------------------------
// DEALERSHIP DOCUMENTS
// -----------------------------------------------------------------------------

model DealerDocument {
  id              String         @id @default(uuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User           @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  documentType    String         // e.g., 'ID', 'DEALER_LICENSE', 'INSURANCE'
  filePath        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  
  reviewerId      String?
  reviewer        User?          @relation("ReviewedDocuments", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("dealerdocument")
}

model DealershipContract {
  id                String         @id @default(uuid())
  storeId           String
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  liaisonId         String
  liaison           User           @relation("SignedContracts", fields: [liaisonId], references: [id])
  status            ContractStatus @default(DRAFT)
  templateName      String
  
  unsignedPdfUrl    String?
  signedPdfUrl      String?
  signatureDataUrl  String?      @db.Text
  
  signedAt          DateTime?
  
  reviewerId        String?
  reviewer          User?          @relation("ReviewedContracts", fields: [reviewerId], references: [id])
  reviewedAt        DateTime?
  rejectionReason   String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("dealershipcontract")
}

model OrganizationVerification {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  
  legalName       String?
  businessType    String?
  registrationNo  String?
  taxId           String?
  
  addressStreet   String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  
  primaryContact  String?
  contactEmail    String?
  contactPhone    String?
  
  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("organization_verification")
}

model ReconditioningOrder {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  description     String   @db.Text
  vendor          String?
  estimatedCost   Float    @default(0)
  actualCost      Float    @default(0)
  status          String   @default("OPEN") // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("reconditioning_order")
}

model WebsiteSetting {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  siteName        String?
  contactEmail    String?
  contactPhone    String?
  theme           String   @default("light")
  primaryColor    String?
  domain          String?  @unique
  isPublished     Boolean  @default(false)
  
  seoTitle        String?
  seoDescription  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VehicleMedia {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  mediaType       String   // "IMAGE" or "VIDEO"
  url             String
  isAiEnhanced    Boolean  @default(false)
  isLiveStream    Boolean  @default(false)
  sortOrder       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VehiclePublishing {
  id              String   @id @default(uuid())
  vehicleId       String   @unique
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  status          String   @default("DRAFT") // DRAFT, PUBLISHED, FAILED
  providerId      String?  // External ID if published
  lastPublishedAt DateTime?
  errorLogs       String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PhoneSetting {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  isEnabled       Boolean  @default(false)
  timezone        String   @default("America/New_York")
  greeting        String?
  fallbackPhone   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PaymentInstallment {
  id              String   @id @default(uuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  amountDue       Float
  dueDate         DateTime
  status          String   @default("SCHEDULED") // SCHEDULED, PAID, OVERDUE
  paidDate        DateTime?
  reference       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IntegrationSetting {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  provider        String   // QUICKBOOKS, DESKMANAGER
  isConnected     Boolean  @default(false)
  lastSyncAt      DateTime?
  syncStatus      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([organizationId, provider])
}

model TeamInvitation {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  email           String
  role            String
  tokenHash       String   @unique
  expiresAt       DateTime
  status          String   @default("PENDING") // PENDING, ACCEPTED, REVOKED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
