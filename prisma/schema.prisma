generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  GUEST
  LIAISON
  SALES_REP
  SALES_MGR
  DEALER_PRO
  BROKER
  AMP_AFFILIATE
  EXECUTIVE_ADMIN
  MEMBER
}

enum SubscriptionTier {
  MARKETPLACE
  CRM
  CENTRAL_OFFICE
}

enum VehicleStatus {
  AVAILABLE
  HOLD
  PENDING_SALE
  SOLD
  DRAFT
  IN_RECON
}

enum LeadStatus {
  New
  Assigned
  In_Progress
  Test_Drive_Scheduled
  Contract_Pending
  Closed_Won
  Closed_Lost
  Expired
}

enum DealStatus {
  PENDING
  DESKING
  E_SIGN
  FINANCED
  CLOSED
}

enum ESignStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  FUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum LeadQualification {
  BUY_NOW
  BUYER_SHOPPING_AROUND
  TAKING_TIME
  SHOPPING_AROUND
  NEW_LEAD
}

enum AssignmentAction {
  ASSIGNED
  RELEASED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model Store {
  id              String  @id @default(uuid())
  name            String
  dba             String?
  street_address  String?
  city            String
  state           String
  zip             String?
  phone           String?
  dms_provider    String  @default("CDK") // CDK, DealerSocket, Frazer
  dms_account_id  String?
  is_pilot_dealer Boolean @default(false)
  activeUnits     Int     @default(0)

  users          User[]
  vehicles       Vehicle[]
  deals          Deal[]
  expenses       Expense[]
  roiReports     ROIReport[]
  leads          Lead[]
  trackingEvents TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store")
}

model User {
  id      String  @id @default(uuid())
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  role         Role    @default(GUEST)
  roleName     String?
  full_name    String?
  email        String? @unique
  passwordHash String?
  phone        String?
  is_active    Boolean @default(true)
  badge        String?
  theme        String  @default("light")
  defaultRoute String?

  subscriptions UserSubscription[]

  // Relations
  vehiclesPosted   Vehicle[]       @relation("PostedVehicles")
  favorites        Favorite[]
  dealsHandled     Deal[]          @relation("SalesRepsOnDeal")
  dealsClosed      Deal[]          @relation("ClosingManager")
  messagesSent     Message[]       @relation("Sender")
  messagesReceived Message[]       @relation("Receiver")
  leadsAssigned    Lead[]          @relation("AssignedLeads")
  leadsReferred    Lead[]          @relation("AmpAffiliate")
  callLogs         CallLog[]
  salesNotes       SalesNote[]
  affiliateLinks   AffiliateLink[]
  commissions      Commission[]

  endUserLeads        Lead[]              @relation("EndUserLeads")
  trackingEvents      TrackingEvent[]
  notifications       LeadNotification[]
  assignmentsMade     LeadAssignmentLog[] @relation("AssignedByUser")
  assignmentsReceived LeadAssignmentLog[] @relation("AssignedToUser")
  transportBookings   TransportBooking[]
  leadMessages        LeadMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model UserSubscription {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier
  active    Boolean          @default(true)
  startDate DateTime         @default(now())
  endDate   DateTime?

  @@map("usersubscription")
}

model Vehicle {
  id      String  @id @default(uuid())
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  vin            String?       @unique
  year           Int?
  make           String?
  model          String?
  trim           String?
  body_class     String?
  selling_price  Float         @default(0.0)
  mileage        Int           @default(0)
  exterior_color String?
  transmission   String        @default("Automatic")
  lot_status     VehicleStatus @default(AVAILABLE)
  image_urls     Json          @default("[]")
  last_dms_sync  DateTime?

  title       String?
  category    String?
  location    String?
  truYou      Boolean @default(false)
  marketPrice Float?
  titleStatus String?

  posterId String?
  poster   User?   @relation("PostedVehicles", fields: [posterId], references: [id])

  favoritedBy    Favorite[]
  leads          Lead[]
  deals          Deal[]
  reconTickets   ReconTicket[]
  photos         VehiclePhoto[]
  socialPosts    SocialPost[]
  trackingEvents TrackingEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("vehicle")
}

model RolePermission {
  id          String   @id @default(uuid())
  role        Role     @unique
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@map("rolepermission")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@map("favorite")
}

model Lead {
  id        String   @id @default(uuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  amp_affiliate_id String?
  amp_affiliate    User?   @relation("AmpAffiliate", fields: [amp_affiliate_id], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String?

  buying_timeline        String?
  is_buy_now             Boolean @default(false)
  phone_consent          Boolean @default(false)
  dwell_duration_seconds Int     @default(10)

  status        LeadStatus         @default(New)
  qualification LeadQualification?
  score         Int                @default(0)
  notes         String?
  source        String?

  expires_at DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  endUserId String?
  endUser   User?   @relation("EndUserLeads", fields: [endUserId], references: [id], onDelete: SetNull)

  callLogs       CallLog[]
  salesNotes     SalesNote[]
  deals          Deal[]
  notifications  LeadNotification[]
  assignmentLogs LeadAssignmentLog[]
  messages       LeadMessage[]

  @@map("lead")
}

model LeadMessage {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  isFromLead Boolean  @default(false)
  read       Boolean  @default(false)
  source     String   @default("OMP_INBOX")
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@map("leadmessage")
}

model CallLog {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  repId  String
  rep    User   @relation(fields: [repId], references: [id], onDelete: Restrict)

  disposition          String
  duration_seconds     Int       @default(0)
  scheduled_test_drive DateTime?

  createdAt DateTime @default(now())

  @@map("calllog")
}

model SalesNote {
  id       String @id @default(uuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  content   String
  createdAt DateTime @default(now())

  @@map("salesnote")
}

model Deal {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  salesRepId String
  salesRep   User   @relation("SalesRepsOnDeal", fields: [salesRepId], references: [id])

  closingManagerId String?
  closingManager   User?   @relation("ClosingManager", fields: [closingManagerId], references: [id])

  customerName String
  status       DealStatus @default(PENDING)

  // 60s Desking Calculator / 4-Square Data
  sale_price      Float
  down_payment    Float @default(0.0)
  trade_allowance Float @default(0.0)
  trade_payoff    Float @default(0.0)
  doc_fee         Float @default(899.00)
  tax_amount      Float @default(0.0)
  apr             Float @default(0.0)
  term_months     Int   @default(72)
  monthly_payment Float @default(0.0)
  dealer_reserve  Float @default(0.0)

  esign_status ESignStatus @default(DRAFT)
  signed_at    DateTime?

  // Finance & BHPH
  lenderId      String?
  lender        Lender?      @relation(fields: [lenderId], references: [id])
  isBHPH        Boolean      @default(false)
  bhphAccountId String?      @unique
  bhphAccount   BHPHAccount? @relation(fields: [bhphAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deal")
}

model Message {
  id         String @id @default(uuid())
  senderId   String
  sender     User   @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("Receiver", fields: [receiverId], references: [id])

  content String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("message")
}

// -----------------------------------------------------------------------------
// DEALERSHIP OPERATIONS & EXECUTIVE SUITE
// -----------------------------------------------------------------------------

model DMSFeed {
  id               String   @id @default(uuid())
  provider         String // CDK, Reynolds, DealerTrack, etc.
  lastSync         DateTime @default(now())
  status           String // SUCCESS, FAILED
  recordsProcessed Int      @default(0)

  @@map("dmsfeed")
}

model ReconTicket {
  id          String       @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  description String
  cost        Float
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("reconticket")
}

model VehiclePhoto {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  url          String
  isAIEnhanced Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("vehiclephoto")
}

model SocialPost {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  platform  String // Facebook, Instagram, Twitter
  content   String
  postedAt  DateTime @default(now())

  @@map("socialpost")
}

model Expense {
  id       String   @id @default(uuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id])
  category String
  amount   Float
  date     DateTime @default(now())

  @@map("expense")
}

model ROIReport {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  month      Int
  year       Int
  revenue    Float
  costs      Float
  roiPercent Float
  createdAt  DateTime @default(now())

  @@map("roireport")
}

// -----------------------------------------------------------------------------
// FINANCING & BHPH SUITE
// -----------------------------------------------------------------------------

model Lender {
  id    String @id @default(uuid())
  name  String
  tier  String // Prime, Subprime, etc.
  deals Deal[]

  @@map("lender")
}

model BHPHAccount {
  id              String        @id @default(uuid())
  balance         Float
  nextPaymentDate DateTime
  status          String // CURRENT, PAST_DUE, DEFAULT
  deal            Deal?
  payments        BHPHPayment[]

  @@map("bhphaccount")
}

model BHPHPayment {
  id        String      @id @default(uuid())
  accountId String
  account   BHPHAccount @relation(fields: [accountId], references: [id])
  amount    Float
  date      DateTime    @default(now())

  @@map("bhphpayment")
}

// -----------------------------------------------------------------------------
// AMP AFFILIATE MARKETING & SAFETY
// -----------------------------------------------------------------------------

model AffiliateLink {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  ref_code              String   @unique
  commission_rate       Float    @default(250.00)
  total_clicks          Int      @default(0)
  total_sales           Int      @default(0)
  total_commission_paid Float    @default(0.00)
  createdAt             DateTime @default(now())

  @@map("affiliatelink")
}

model Commission {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  status    String // PENDING, PAID
  createdAt DateTime @default(now())

  @@map("commission")
}

model PoliceSafeSpot {
  id               String   @id @default(uuid())
  department_name  String
  street_address   String
  city             String
  state            String
  zip              String
  latitude         Float
  longitude        Float
  surveillance_247 Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("policesafespot")
}

model TrackingEvent {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  duration_seconds Int
  createdAt        DateTime @default(now())

  @@index([storeId, createdAt])
  @@map("trackingevent")
}

model LeadAssignmentLog {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignedById String
  assignedBy   User   @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)

  action    AssignmentAction
  createdAt DateTime         @default(now())

  @@index([leadId])
  @@map("leadassignmentlog")
}

model LeadNotification {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  read      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([expiresAt])
  @@map("leadnotification")
}

model TransportBooking {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originZip      String
  destZip        String
  carrierType    String
  estimatedMiles Int
  estimatedPrice Float
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@map("transportbooking")
}
